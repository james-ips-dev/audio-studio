## 6. Comprehensive TypeScript Data Schema (`IndexedDB`, `.json`, `.mid`, `.wav`)

```typescript
export type AppMode = 'beginner' | 'pro';
export type VoiceMode = 'mono' | 'poly' | 'unison';
export type NotePriority = 'last' | 'low' | 'high';
export type GlideTrigger = 'always' | 'legato';
export type GlideCurve = 'linear' | 'exponential';

export type OscillatorWave = 'sine' | 'triangle' | 'sawtooth' | 'square' | 'pwm' | 'supersaw';
export type FilterType = 'lp12' | 'lp24' | 'bp12' | 'hp12' | 'notch';
export type LfoWave = 'sine' | 'triangle' | 'saw' | 'square' | 'sample-hold';
export type RatchetCurve = 'flat' | 'fade-out' | 'swell' | 'bouncing-ball';
export type TrigCondition = 'ALWAYS' | '1:2' | '2:2' | '1:4' | '2:4' | '3:4' | '4:4' | 'FILL' | 'PRE' | '!PRE';

export type LaunchQuantize = 'immediate' | '1/16' | '1-beat' | '1-bar' | '2-bars';
export type CrossfadeCurveMode = 'dj-eq-blend' | 'filter-morph' | 'step-probability-morph';

export type Subdivision =
  | '1/4' | '1/8' | '1/16' | '1/32' | '1/64'
  | '1/4T' | '1/8T' | '1/16T' | '1/32T'
  | '1/8D' | '1/16D';

// Standardized Parameter Dot-Path Convention: e.g. "tracks.4.synth.filter.cutoff"
export type ParameterDotPath = string;

export interface PerformanceSessionState {
  activeTrackPatterns: string[];          // 8 pattern IDs (one per track 0..7), e.g. ['A1','B2','A1','A1','C1','A1','A4','A1']
  queuedTrackPatterns: (string | null)[]; // Pending quantized clip switches per track
  launchQuantize: LaunchQuantize;
  legatoPhaseLock: boolean;               // Preserves current step offset when switching clips mid-bar
  deckA: string[];                        // 8-track pattern assignment snapshot for Crossfader Deck A
  deckB: string[];                        // 8-track pattern assignment snapshot for Crossfader Deck B
  crossfaderPosition: number;             // 0.0 (100% Deck A) to 1.0 (100% Deck B)
  crossfadeMode: CrossfadeCurveMode;
  activePunchInFx: 'none' | 'tape-stop' | 'beat-repeat' | 'dub-wash' | 'sub-drop' | 'hpf-riser';
}

export interface ModMatrixSlot {
  id: number; // 0..7
  enabled: boolean;
  source:
    | 'lfo1' | 'lfo2' | 'filterEnv' | 'modEnv' | 'modSeq'
    | 'velocity' | 'keyTrack' | 'voiceRandom' | 'osc2Fm'
    | 'kaossX' | 'kaossY' | 'macro1' | 'macro2';
  curve: 'linear' | 'exponential' | 's-curve' | 'stepped';
  depth: number; // -1.0 to +1.0
  destination:
    | 'cutoff' | 'resonance' | 'drive'
    | 'osc1Pitch' | 'osc2Pitch' | 'pwm' | 'fmCrossMod'
    | 'osc1Level' | 'osc2Level' | 'sub1Level' | 'sub2Level' | 'noiseLevel'
    | 'pan' | 'stereoWidth' | 'unisonDetune' | 'glideTime'
    | 'ampAttack' | 'ampDecay' | 'filterEnvAmt'
    | 'lfo1Rate' | 'lfo2Rate'
    | 'insert1Param1' | 'insert1Param2'
    | 'reverbSend' | 'delaySend';
}

export interface ProSynthConfig {
  // Voice Allocation, Unison, Portamento & Analog Imperfection
  voice: {
    mode: VoiceMode;
    legato: boolean;
    priority: NotePriority;
    polyVoices: number;       // 4..8
    unisonVoices: number;     // 2..4
    unisonDetune: number;     // 0..100 cents
    unisonSpread: number;     // 0..1 stereo width
    glideTime: number;        // 0..1000 ms
    glideTrigger: GlideTrigger;
    glideCurve: GlideCurve;
    analogSlop: number;       // 0..1 per-voice pitch/filter/env organic drift
    keyTunedDrum: boolean;    // Auto-tunes Kick/Perc fundamental to global Song Key
  };

  // 2 Primary Oscillators + 2 Sub-Oscillators + Noise
  osc1: { wave: OscillatorWave; coarse: number; fine: number; pwm: number; keySync: boolean; keyTrack: boolean; level: number };
  osc2: { wave: OscillatorWave; coarse: number; fine: number; hardSync: boolean; fmDepth: number; keySync: boolean; keyTrack: boolean; level: number };
  sub1: { wave: 'sine' | 'square'; octaveOffset: -12; keySync: boolean; level: number };
  sub2: { wave: 'sine' | 'triangle' | 'square'; semitoneOffset: -24 | -12 | 7; keySync: boolean; level: number };
  noise: { type: 'white' | 'pink' | 'metallic'; ringMod: boolean; level: number };

  // Multi-mode Filter & Drive
  filter: {
    type: FilterType;
    cutoff: number;           // 20..20000 Hz
    resonance: number;        // 0.5..20 Q
    drive: number;            // 0..1
    keyTrack: number;         // 0..1
    envDepth: number;         // -1..1
    velocityTimbre: number;   // 0..1 built-in Acoustic Touch Response depth
  };

  // 3 Independent Envelopes
  ampEnv: { attack: number; decay: number; sustain: number; release: number };
  filterEnv: { attack: number; decay: number; sustain: number; release: number };
  modEnv: { delay: number; attack: number; decay: number; sustain: number; release: number; loop: boolean };

  // Dual LFOs + 16-Step Mod Sequencer + 8-Slot Mod Matrix
  lfo1: { wave: LfoWave; sync: boolean; rateHz: number; rateDiv: Subdivision; fadeIn: number; retrigger: boolean };
  lfo2: { wave: LfoWave; sync: boolean; rateHz: number; rateDiv: Subdivision; fadeIn: number; retrigger: boolean };
  modSequencer: { enabled: boolean; subdivision: Subdivision; steps: number[] }; // 16 values (-1..1)
  modMatrix: ModMatrixSlot[];

  // Beginner Mode 6-Macro Snapshot (mapped dynamically to Pro params)
  beginnerMacros: Record<string, number>;
}

export interface InsertFxUnit {
  type: 'drive' | 'transientShaper' | 'bitcrusher' | 'chorusTape' | 'eq4' | 'sidechainComp';
